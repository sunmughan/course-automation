generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("student")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  studentSkills StudentSkill[]
  progress      StudentProgress[]
  mistakes      StudentMistake[]
  submissions   Submission[]
  aiSessions    AISession[]
  assessmentScores AssessmentScore[]
  enrolledCourses EnrolledCourse[]
  taughtBatches  Batch[]
  interventions  Intervention[]       @relation("InterventionInstructor")
  studentInterventions Intervention[] @relation("InterventionStudent")
  batchMemberships BatchStudent[]
  assignmentSubmissions AssignmentSubmission[]
  announcements  Announcement[]
  orgMemberships OrganizationMember[]
  teamMemberships TeamMember[]
  auditLogs          AuditLog[]
  interviews         InterviewSession[]
  playgroundProjects PlaygroundProject[]
  projectSessions    ProjectSession[]
  projectExecutions  ProjectExecution[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  slug        String   @unique
  stream      String
  imageUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules    Module[]
  projects   Project[]
  enrollments EnrolledCourse[]
  batches    Batch[]
}

model EnrolledCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Float    @default(0)
  status    String   @default("active")
  enrolledAt DateTime @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String
  slug        String
  order       Int      @default(0)
  courseId    String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@unique([courseId, slug])
}

model Topic {
  id            String   @id @default(cuid())
  title         String
  description   String
  slug          String
  order         Int      @default(0)
  moduleId      String
  difficulty    Int      @default(1)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module        Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  prerequisites TopicPrerequisite[] @relation("TopicPrerequisites")
  dependedBy    TopicPrerequisite[] @relation("TopicDependedBy")
  assignments   Assignment[]
  studentSkills StudentSkill[]

  @@unique([moduleId, slug])
}

model TopicPrerequisite {
  id              String @id @default(cuid())
  topicId         String
  prerequisiteId  String

  topic         Topic @relation("TopicPrerequisites", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite  Topic @relation("TopicDependedBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([topicId, prerequisiteId])
}

model Lesson {
  id              String   @id @default(cuid())
  title           String
  slug            String
  content         String
  explanation     String
  order           Int      @default(0)
  topicId         String
  difficultyLevel Int      @default(1)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topic       Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  examples    Example[]
  exercises   Exercise[]
  assessments Assessment[]
  concepts    Concept[]
  visualizations Visualization[]

  @@unique([topicId, slug])
}

model Concept {
  id          String   @id @default(cuid())
  title       String
  description String
  lessonId    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Example {
  id            String   @id @default(cuid())
  title         String
  description   String
  starterCode   String
  solutionCode  String
  lessonId      String
  testCases     String
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Exercise {
  id            String   @id @default(cuid())
  title         String
  description   String
  instructions  String
  starterCode   String
  solutionCode  String
  testCases     String
  hints         String
  lessonId      String
  difficulty    Int      @default(1)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model CodeFile {
  id        String   @id @default(cuid())
  name      String
  content   String
  language  String
  lessonId  String?
  projectId String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  courseId    String
  difficulty  Int      @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  exerciseId  String?
  code        String
  language    String   @default("javascript")
  status      String   @default("pending")
  score       Float?
  feedback    String?
  createdAt   DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id])
  executionRuns ExecutionRun[]
}

model ExecutionRun {
  id           String   @id @default(cuid())
  submissionId String?
  code         String
  language     String
  output       String
  error        String?
  status       String
  exitCode     Int?
  executionTime Float?
  memoryUsed   Float?
  events       String
  createdAt    DateTime @default(now())

  submission Submission? @relation(fields: [submissionId], references: [id])
}

model AISession {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  lessonId  String?
  mode      String   @default("explain")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
}

model AIMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  code      String?
  diagram   String?
  events    String?
  createdAt DateTime @default(now())

  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AIRequest {
  id                 String    @id @default(cuid())
  requestId          String    @unique
  userId             String
  organizationId     String?
  sessionId          String?
  provider           String
  model              String
  agent               String?
  mode                String
  inputTokens         Int       @default(0)
  outputTokens        Int       @default(0)
  totalTokens         Int       @default(0)
  latency             Float     @default(0)
  cost                Float     @default(0)
  estimatedCost       Float     @default(0)
  status              String
  error               String?
  fallbackUsed        Boolean   @default(false)
  attemptedProviders  String    @default("[]")
  attemptedModels     String    @default("[]")
  finalProvider       String?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([createdAt])
}

model AIProvider {
  id          String   @id @default(cuid())
  name        String   @unique
  baseUrl     String
  apiKey      String
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models     AIModel[]
  healthLogs ProviderHealth[]
}

model AIModel {
  id           String   @id @default(cuid())
  name         String
  providerId   String
  capabilities String
  maxTokens    Int      @default(4096)
  costPer1K    Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderHealth {
  id          String   @id @default(cuid())
  providerId  String
  successRate Float    @default(100)
  avgLatency  Float    @default(0)
  errorRate   Float    @default(0)
  isHealthy   Boolean  @default(true)
  checkedAt   DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model RoutingRule {
  id          String   @id @default(cuid())
  taskType    String
  preferredProvider String
  preferredModel    String
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model StudentSkill {
  id            String    @id @default(cuid())
  userId        String
  topicId       String
  skillName     String
  score         Float     @default(0)
  status        String    @default("beginner")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?

  // Spaced Repetition (SM-2) State
  easeFactor    Float     @default(2.5)
  interval      Int       @default(0)
  repetitions   Int       @default(0)
  nextReviewAt  DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model StudentProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  status    String   @default("not_started")
  score     Float?
  timeSpent Int      @default(0)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model StudentMistake {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  lessonId  String?
  code      String
  error     String
  fix       String?
  count     Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id        String   @id @default(cuid())
  title     String
  lessonId  String
  timeLimit Int?
  passingScore Float @default(70)
  createdAt DateTime @default(now())

  lesson   Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
  scores    AssessmentScore[]
}

model AssessmentQuestion {
  id           String   @id @default(cuid())
  assessmentId String
  type         String
  question     String
  code         String?
  options      String?
  correctAnswer String
  explanation  String?
  testCases    String?
  points       Int      @default(1)
  order        Int      @default(0)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentScore {
  id           String   @id @default(cuid())
  userId       String
  assessmentId String
  score        Float
  totalPoints  Float
  answers      String
  timeSpent    Int?
  passed       Boolean  @default(false)
  attempts     Int      @default(1)
  completedAt  DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assessmentId])
}

model Visualization {
  id        String   @id @default(cuid())
  lessonId  String
  type      String
  title     String
  config    String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  event          String
  data           String
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([event])
  @@index([createdAt])
}

model Batch {
  id             String    @id @default(cuid())
  name           String
  description    String?
  instructorId   String
  courseId       String?
  organizationId String?
  departmentId   String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  instructor     User          @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  students       BatchStudent[]
  assignments    Assignment[]
  announcements  Announcement[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([instructorId])
}

model BatchStudent {
  id        String   @id @default(cuid())
  batchId   String
  studentId String
  status    String   @default("active")
  joinedAt  DateTime @default(now())

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  instructions String?
  batchId     String
  topicId     String?
  difficulty  Int      @default(2)
  maxScore    Int      @default(100)
  dueDate     DateTime?
  type        String   @default("coding")
  starterCode String?
  rubric      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch       Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  topic       Topic?                 @relation(fields: [topicId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  code         String?
  answer       String?
  score        Int?
  feedback     String?
  status       String   @default("submitted")
  submittedAt  DateTime @default(now())
  gradedAt     DateTime?
  gradedBy     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Intervention {
  id          String   @id @default(cuid())
  studentId   String
  instructorId String
  type        String
  title       String
  description String
  status      String   @default("active")
  outcome     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student    User @relation("InterventionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("InterventionInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  content      String
  batchId      String?
  instructorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batch      Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instructor User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  primaryColor String  @default("#3B82F6")
  accentColor  String  @default("#8B5CF6")
  customDomain String?
  isActive    Boolean  @default(true)
  settings    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members          OrganizationMember[]
  teams            Team[]
  departments      Department[]
  batches          Batch[]
  subscriptions    Subscription[]
  ssoConfigs       SSOConfig[]
  auditLogs        AuditLog[]
  customCurriculums CustomCurriculum[]
  customAIModels   CustomAIModel[]
  policies         Policy[]
  analyticsEvents  AnalyticsEvent[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  permissions    String   @default("[]")
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  departmentId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members      TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Department {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentHierarchy")
  teams        Team[]
  batches      Batch[]
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  details        String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model BillingPlan {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  priceMonthly  Float    @default(0)
  priceYearly   Float    @default(0)
  maxStudents   Int      @default(10)
  maxInstructors Int     @default(1)
  maxTeams      Int      @default(3)
  features      String   @default("[]")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  status         String   @default("active")
  billingCycle   String   @default("monthly")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  paymentMethodId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BillingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
}

model SSOConfig {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  clientId       String?
  clientSecret   String?
  issuerUrl      String?
  domain         String?
  isEnabled      Boolean  @default(false)
  settings       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model CustomCurriculum {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         String   @default("draft")
  settings       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modules      CustomModule[]

  @@index([organizationId])
}

model CustomModule {
  id           String   @id @default(cuid())
  curriculumId String
  title        String
  description  String?
  order        Int      @default(0)
  settings     String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum CustomCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@index([curriculumId])
}

model CustomAIModel {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  provider       String
  model          String
  capabilities   String   @default("[]")
  maxTokens      Int      @default(4096)
  costPer1K      Float    @default(0)
  settings       String   @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Policy {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String
  description    String?
  rules          String   @default("{}")
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model InterviewSession {
  id                String            @id @default(cuid())
  userId            String
  topicId           String?
  courseId          String?
  role              String            @default("Full-Stack Engineer")
  targetLevel       String            @default("mid")
  status            String            @default("in_progress")
  currentDifficulty Int               @default(2)
  overallScore      Float?
  technicalAccuracy Float?
  problemSolving    Float?
  depth             Float?
  communication     Float?
  summaryFeedback   String?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  updatedAt         DateTime          @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns InterviewTurn[]

  @@index([userId])
  @@index([topicId])
}

model InterviewTurn {
  id                String            @id @default(cuid())
  sessionId         String
  turnNumber        Int
  question          String
  questionType      String            @default("technical")
  difficulty        Int               @default(2)
  candidateAnswer   String?
  technicalAccuracy Float?
  problemSolving    Float?
  depth             Float?
  communication     Float?
  turnScore         Float?
  evaluatorFeedback String?
  strengths         String?
  improvements      String?
  followUpQuestion  String?
  createdAt         DateTime          @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PlaygroundProject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  settings    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  sessions    ProjectSession[]
  executions  ProjectExecution[]

  @@index([userId])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  path      String
  content   String   @default("")
  language  String   @default("javascript")
  isFolder  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   PlaygroundProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

model ProjectSession {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  activeFileId String?
  cursorPos    String?
  openTabs     String   @default("[]")
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      PlaygroundProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model ProjectExecution {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  entryFile     String   @default("src/main.js")
  language      String   @default("javascript")
  code          String
  output        String   @default("")
  error         String?
  status        String   @default("success")
  exitCode      Int?     @default(0)
  executionTime Float?   @default(0)
  memoryUsed    Float?   @default(0)
  createdAt     DateTime @default(now())

  project       PlaygroundProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}